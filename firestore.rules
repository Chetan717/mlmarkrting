rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function appUser() { return signedIn() && request.auth.uid.matches('mobile_[0-9]{10}'); }
    function ownsMobile(mobile) { return appUser() && mobile is string && request.auth.uid == 'mobile_' + mobile; }

    function validPanelSession(panel) {
      return signedIn()
        && get(/databases/$(database)/documents/_panelSessions/$(request.auth.uid)).data.panel == panel
        && get(/databases/$(database)/documents/_panelSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function admin() { return signedIn() && request.auth.token.panel == 'admin' && validPanelSession('admin'); }
    function masterAdmin() { return admin() && request.auth.token.role == 'Master Admin' && request.auth.token.actorType == 'owner'; }
    function adminTab(tab) {
      return admin() && (request.auth.token.role == 'Master Admin' || tab in request.auth.token.tabs);
    }

    function marketing() { return signedIn() && request.auth.token.panel == 'marketing' && validPanelSession('marketing'); }
    function marketingOwner() { return marketing() && request.auth.token.actorType == 'owner'; }
    function marketingTab(tab) { return marketing() && tab in request.auth.token.tabs; }
    function ownMteam(id) { return marketing() && request.auth.token.mteamId == id; }
    function assignedCouponId() {
      return get(/databases/$(database)/documents/mteam/$(request.auth.token.mteamId)).data.assign_coupon_id;
    }
    function assignedCouponCode() {
      return get(/databases/$(database)/documents/couponcode/$(assignedCouponId())).data.code;
    }

    match /users/{userId} {
      allow read: if ownsMobile(resource.data.mobileNo)
        || adminTab('dashboard') || adminTab('userdashboard') || adminTab('leads')
        || (marketing() && resource.data.referredByMteam == request.auth.token.mteamId);
      allow update: if ownsMobile(resource.data.mobileNo)
        && request.resource.data.mobileNo == resource.data.mobileNo
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50;
      allow create, delete: if false;
    }

    match /userCompanySelections/{uid} {
      allow read, create, delete: if appUser() && request.auth.uid == uid;
      allow update: if false;
    }

    match /mlmprofiles/{profileId} {
      allow read: if ownsMobile(resource.data.mobile) || admin();
      allow create: if ownsMobile(request.resource.data.mobile)
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 100;
      allow update: if ownsMobile(resource.data.mobile)
        && request.resource.data.mobile == resource.data.mobile
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName','designation','logoURLs','profileImageURLs','topuplineURLs',
          'socials','companyId','companyName','updatedAt'
        ]);
      allow delete: if ownsMobile(resource.data.mobile);
    }

    match /adminuser/{adminId} {
      allow read: if masterAdmin();
      allow create: if masterAdmin()
        && request.resource.data.ownerAdminId == request.auth.token.ownerAdminId
        && request.resource.data.role != 'Master Admin'
        && !request.resource.data.keys().hasAny(['pin','password']);
      allow update: if masterAdmin()
        && adminId != request.auth.token.ownerAdminId
        && request.resource.data.ownerAdminId == resource.data.ownerAdminId
        && request.resource.data.ownerAdminId == request.auth.token.ownerAdminId
        && request.resource.data.role != 'Master Admin'
        && !request.resource.data.keys().hasAny(['pin','password']);
      allow delete: if masterAdmin() && adminId != request.auth.token.ownerAdminId;
    }

    match /mteam/{mteamId} {
      allow read: if adminTab('dashboard') || adminTab('leads') || adminTab('marketing') || ownMteam(mteamId);
      allow create, delete: if adminTab('marketing');
      allow update: if adminTab('marketing')
        || (ownMteam(mteamId) && marketingOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team','updatedAt'])
          && request.resource.data.team is list);
    }

    match /couponcode/{couponId} {
      allow read: if adminTab('marketing')
        || (marketing() && couponId == assignedCouponId());
      allow create, update, delete: if adminTab('marketing');
    }

    match /subscription/{docId} {
      allow read: if adminTab('dashboard') || adminTab('userdashboard') || adminTab('leads')
        || (marketing() && resource.data.couponApplied == assignedCouponCode());
      allow write: if false;
    }

    match /leadBysubuserMarketingMember/{docId} {
      allow read: if adminTab('leads')
        || (marketingTab('leads') && resource.data.mteamId == request.auth.token.mteamId);
      allow create: if marketingTab('leads')
        && request.resource.data.mteamId == request.auth.token.mteamId;
      allow update, delete: if marketingTab('leads')
        && resource.data.mteamId == request.auth.token.mteamId
        && request.resource.data.mteamId == request.auth.token.mteamId;
    }

    match /freshleads/{docId} {
      allow read: if adminTab('leads')
        || (marketingTab('freshleads') && resource.data.mteamId == request.auth.token.mteamId);
      allow create: if marketingTab('freshleads')
        && request.resource.data.mteamId == request.auth.token.mteamId;
      allow update, delete: if marketingTab('freshleads')
        && resource.data.mteamId == request.auth.token.mteamId
        && request.resource.data.mteamId == request.auth.token.mteamId;
    }

    match /mlmcomp/{docId} {
      allow read: if appUser() || marketing() || admin();
      allow create, update, delete: if adminTab('companies');
    }
    match /mlmtemplate/{docId} {
      allow read: if appUser() || admin();
      allow create, update, delete: if adminTab('templates') || adminTab('templates_operation');
    }
    match /templatequality/{docId} {
      allow read: if appUser() || admin();
      allow create, update: if adminTab('templates') || adminTab('templates_quality');
      allow delete: if masterAdmin();
    }
    match /mlmgraphics/{docId} {
      allow read: if appUser() || admin();
      allow create, update, delete: if adminTab('Graphics');
    }
    match /music/{docId} {
      allow read: if appUser() || admin();
      allow create, update, delete: if adminTab('Graphics');
    }
    match /removebg/{docId} {
      allow read: if adminTab('removebg');
      allow create, update: if adminTab('removebg');
      allow delete: if masterAdmin();
    }

    match /fcmTokens/{mobile} {
      allow read, delete: if ownsMobile(mobile);
      allow create, update: if ownsMobile(mobile)
        && request.resource.data.mobileNo == mobile
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 500;
    }

    match /leadmanagement/{docId} {
      allow read: if adminTab('leads');
      allow create, update, delete: if adminTab('leads');
    }
    match /reportingUser/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /teamrequests/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /reportguest/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /reportfollowup/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /reportkitbook/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /reportnac/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /reportnextday/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /reportplan/{docId} { allow read: if adminTab('leads'); allow write: if false; }
    match /reportsp/{docId} { allow read: if adminTab('leads'); allow write: if false; }

    match /paymentlog/{docId} { allow read, write: if false; }
    match /askaicredit/{docId} { allow read, write: if false; }
    match /_rateLimits/{docId} { allow read, write: if false; }
    match /_authSessions/{docId} { allow read, write: if false; }
    match /_panelLoginLimits/{docId} { allow read, write: if false; }
    match /_panelSessions/{docId} { allow read, write: if false; }
    match /_panelOtpChallenges/{docId} { allow read, write: if false; }
    match /_panelCredentials/{docId} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
